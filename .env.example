# Criada automaticamente pela integração Neon, ou informe manualmente:
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Criada automaticamente ao conectar um Blob Store:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Defina estas três variáveis no painel da Vercel (não publique este arquivo com valores reais):
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
